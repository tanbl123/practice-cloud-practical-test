#!/usr/bin/env bash
# Thin wrapper: runs the real AWS CLI against the local simulated AWS (moto).
# Use exactly like `aws`, e.g.  awslocal s3 ls
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
exec "$REPO/.venv/bin/aws" --endpoint-url="${AWS_ENDPOINT_URL:-http://127.0.0.1:5000}" "$@"
